{"repo": {"timestamp": 1789028916000, "version": 20002, "name": "Nothing Modes", "icon": "icon.png", "address": "https://nothing-modes.vercel.app/fdroid/repo", "description": "Self-hosted F-Droid repository for Nothing Modes", "mirrors": [{"isPrimary": true, "url": "https://nothing-modes.vercel.app/fdroid/repo"}]}, "requests": {"install": [], "uninstall": []}, "apps": [{"allowedAPKSigningKeys": ["f18fc9c16edd312eeef719e77384ace251b0d7e750fbade423c1ba79f7c942ac"], "authorEmail": "info@tdvorak.dev", "authorName": "TDvorak", "binaries": "https://github.com/Dvorinka/Nothing_Modes/releases/download/v%v/nothing-modes-v%v.apk", "categories": ["System"], "suggestedVersionCode": "15", "description": "Nothing Modes is an open-source Android automation app for Nothing phones.\n\nModes persist and restore, and fire on real events. Glyph lights respond.\nNo cloud, no telemetry.\n\n- Modes: Sleep, Work, Gaming. A mode holds a set of toggles and reverts them when it ends.\n- Modes can also fire on triggers for time, battery, screen, notifications, connectivity, geofences, and more.\n- Conditions: gate execution with AND logic.\n- Actions: 37+ types, including Glyph patterns and Shizuku-backed system toggles.\n\nThis self-hosted repository keeps every feature. Users of the official F-Droid\nbuild would lose Nothing's proprietary Glyph SDK and Google Play Services.\n", "issueTracker": "https://github.com/Dvorinka/Nothing_Modes/issues", "license": "GPL-3.0-only", "sourceCode": "https://github.com/Dvorinka/Nothing_Modes", "summary": "Automation for Nothing phones", "added": 1789028756000, "packageName": "com.tdvorak.nothingmodes", "lastUpdated": 1789028756000, "localized": {"en-US": {"name": "Nothing Modes"}}}], "packages": {"com.tdvorak.nothingmodes": [{"added": 1789028756000, "apkName": "com.tdvorak.nothingmodes_15.apk", "hash": "8a025c850dc70ab38d22015767a627b938bae4f078931eb3aa5545f319b0d898", "hashType": "sha256", "minSdkVersion": 28, "nativecode": ["arm64-v8a", "armeabi-v7a", "x