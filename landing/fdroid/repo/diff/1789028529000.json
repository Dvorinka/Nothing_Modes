{"repo": {"timestamp": 1789028916000, "categories": {"System": {"name": {"en-US": "System"}, "description": {"en-US": "System tools and utilities"}}}}, "packages": {"com.tdvorak.nothingmodes": {"metadata": {"added": 1789028756000, "categories": ["System"], "issueTracker": "https://github.com/Dvorinka/Nothing_Modes/issues", "lastUpdated": 1789028756000, "license": "GPL-3.0-only", "sourceCode": "https://github.com/Dvorinka/Nothing_Modes", "authorEmail": "info@tdvorak.dev", "authorName": "TDvorak", "name": {"en-US": "Nothing Modes"}, "summary": {"en-US": "Automation for Nothing phones"}, "description": {"en-US": "Nothing Modes is an open-source Android automation app for Nothing phones.\n\nModes persist and restore, and fire on real events. Glyph lights respond.\nNo cloud, no telemetry.\n\n- Modes: Sleep, Work, Gaming. A mode holds a set of toggles and reverts them when it ends.\n- Modes can also fire on triggers for time, battery, screen, notifications, connectivity, geofences, and more.\n- Conditions: gate execution with AND logic.\n- Actions: 37+ types, including Glyph patterns and Shizuku-backed system toggles.\n\nThis self-hosted repository keeps every feature. Users of the official F-Droid\nbuild would lose Nothing's proprietary Glyph SDK and Google Play Services.\n"}, "preferredSigner": "f18fc9c16edd312eeef719e77384ace251b0d7e750fbade423c1ba79f7c942ac"}, "versions": {"8a025c850dc70ab38d22015767a627b938bae4f078931eb3aa5545f319b0d898": {"added": 1789028756000, "file": {"name": "/com.tdvorak.nothingmodes_15.apk", "sha256": "8a025c850dc70ab38d22015767a627b938bae4f078931eb3aa5545f319b0d898", "size": 6903857}, "manifest": {"nativecode": ["arm64-v8a", "armeabi-v7a", "x86", "x86_64"], "versionName": "0.12.1", "versionCode": 15, "usesSdk": {"minSdkVersion": 28, "targetSdkVersion": 36}, "signer": {"sha256": ["f18fc9c16edd312eeef719e77384ace251b0d7e750fbade423c1ba79f7c942ac"]}, "usesPermission": [{"name": "android.permission.REQUEST_INSTALL_PACKAGES"}, {"name": "android.pe