<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.SET_WALLPAPER" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="com.nothing.ketchum.permission.QUERY_GLYPH_STATE" />
    <uses-permission android:name="com.nothing.ketchum.permission.CONTROL_GLYPH" />

    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".NothingModesApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="Nothing Modes"
        android:supportsRtl="true"
        android:theme="@style/Theme.NothingModes.Splash">
        <meta-data
            android:name="com.tdvorak.nothingmodes.distribution"
            android:value="${distribution}" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|density|uiMode|fontScale|locale|layoutDirection"
            android:theme="@style/Theme.NothingModes.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Accept glyph design JSON (GlyphMatrixEditor / Glyph Museum open
                 format) shared to or opened with this app. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/json" />
            </intent-filter>
            <!-- Shared links (Glyph Museum posts, nothingmodes://import) arrive
                 as text/plain from browsers and share sheets. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/json" />
                <data android:scheme="content" />
                <data android:scheme="file" />
            </intent-filter>
            <!-- Accept one-tap community imports from the website. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="nothingmodes" android:host="import" />
            </intent-filter>
            <!-- Glyph Museum post links open straight into an import. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="app.glyphmuseum.com" android:pathPrefix="/post/" />
                <data android:host="glyphmuseum.com" android:pathPrefix="/post/" />
                <data android:host="www.glyphmuseum.com" android:pathPrefix="/post/" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".widget.NothingModesWidgetReceiver"
            android:exported="true"
            android:label="Nothing Modes">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/nothing_modes_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.WidgetUpdateReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.tdvorak.nothingmodes.UPDATE_WIDGET" />
            </intent-filter>
        </receiver>

        <activity
            android:name=".widget.SingleAutomationWidgetConfigActivity"
            android:exported="true"
            android:theme="@style/Theme.NothingModes" />

        <receiver
            android:name=".widget.SingleAutomationWidgetReceiver"
            android:exported="true"
            android:label="Nothing Mode Action">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/single_automation_widget_info" />
        </receiver>

        <service
            android:name=".quicksettings.NothingModesTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_modes"
            android:label="Nothing Modes"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <service
            android:name=".quicksettings.UltraDimTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_ultra_dim"
            android:label="Ultra dim"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Tap-to-cycle tiles: each press applies the next step of a spec.
             Screen timeout and brightness ship fixed steps; the three Custom
             slots are bound by the user inside the app (Quick settings screen). -->
        <service
            android:name=".quicksettings.cycle.ScreenTimeoutTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_timeout"
            android:label="Screen timeout"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <service
            android:name=".quicksettings.cycle.BrightnessTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_brightness"
            android:label="Brightness"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <service
            android:name=".quicksettings.cycle.CustomCycleTileService1"
            android:exported="true"
            android:icon="@drawable/ic_tile_cycle"
            android:label="Custom tile 1"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <service
            android:name=".quicksettings.cycle.CustomCycleTileService2"
            android:exported="true"
            android:icon="@drawable/ic_tile_cycle"
            android:label="Custom tile 2"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <service
            android:name=".quicksettings.cycle.CustomCycleTileService3"
            android:exported="true"
            android:icon="@drawable/ic_tile_cycle"
            android:label="Custom tile 3"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <service
            android:name=".quicksettings.cycle.CustomCycleTileService4"
            android:exported="true"
            android:icon="@drawable/ic_tile_cycle"
            android:label="Custom tile 4"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <service
            android:name=".quicksettings.cycle.CustomCycleTileService5"
            android:exported="true"
            android:icon="@drawable/ic_tile_cycle"
            android:label="Custom tile 5"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <service
            android:name=".quicksettings.cycle.CustomCycleTileService6"
            android:exported="true"
            android:icon="@drawable/ic_tile_cycle"
            android:label="Custom tile 6"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Full-screen editor opened from an unconfigured custom tile tap or
             from the Quick settings screen. -->
        <activity
            android:name=".quicksettings.TileConfigActivity"
            android:exported="false"
            android:theme="@style/Theme.NothingModes" />

        <!-- Home-screen cycle widget: same tap-to-cycle engine as the tiles. -->
        <activity
            android:name=".widget.CycleWidgetConfigActivity"
            android:exported="true"
            android:theme="@style/Theme.NothingModes" />

        <receiver
            android:name=".widget.CycleWidgetReceiver"
            android:exported="true"
            android:label="Cycle control">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/cycle_widget_info" />
        </receiver>

        <!-- Floating intensity panel for the ultra-dim notification. -->
        <activity
            android:name=".quicksettings.DimAdjustActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.NothingModes.DimAdjust" />

        <!-- Notification actions (-10/+10/off) for the ultra-dim overlay.
             Non-exported: only our own PendingIntents may fire it. -->
        <receiver
            android:name=".quicksettings.UltraDimControlReceiver"
            android:exported="false" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
