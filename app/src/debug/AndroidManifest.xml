<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <application>
        <!-- Debug-only shell test hook: `am broadcast -a com.tdvorak.nothingmodes.debug.TEST_ACTION ...`.
             Exists in debug builds only; release manifests never see it. -->
        <receiver
            android:name="com.tdvorak.nothingmodes.DebugActionReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.tdvorak.nothingmodes.debug.TEST_ACTION" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
