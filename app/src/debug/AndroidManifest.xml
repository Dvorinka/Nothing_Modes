<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- USB/MCP debug-only control surface. Not present in release builds. -->
    <application>
        <receiver
            android:name=".DebugActionReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.tdvorak.nothingmodes.debug.TEST_ACTION" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".agent.ModeControlReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.tdvorak.nothingmodes.MCP_CONTROL" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
