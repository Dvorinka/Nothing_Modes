<?xml version="1.0" encoding="utf-8"?>
<!-- Sole purpose: stay bound so the service's WindowManager can host the
     ultra-dim overlay as a trusted TYPE_ACCESSIBILITY_OVERLAY. Events are
     declared minimally and never acted on; no window content is read. -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:notificationTimeout="100"
    android:canRetrieveWindowContent="false"
    android:description="@string/dim_overlay_service_description" />
