<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.SET_WALLPAPER" />

    <application>
        <!-- Hosts the ultra-dim window as a trusted accessibility overlay.
             Processes no events and reads no window content. -->
        <service
            android:name=".controllers.DimOverlayAccessibilityService"
            android:label="@string/dim_overlay_service_label"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/dim_overlay_service" />
        </service>
    </application>
</manifest>
